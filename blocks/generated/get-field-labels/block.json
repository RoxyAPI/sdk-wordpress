{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/get-field-labels",
	"title": "Field Labels for a Language",
	"category": "roxyapi",
	"icon": "portfolio",
	"description": "Returns the display label for every request field name and every selectable option across the , in the requested language",
	"keywords": [
		"languages",
		"roxyapi",
		"get",
		"field"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"inserter": false
	},
	"attributes": {
		"lang": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
