{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/get-yearly-horoscope",
	"title": "Yearly Horoscope by Zodiac Sign (Western Astrology)",
	"category": "roxyapi",
	"icon": "admin-customizer",
	"description": "Year ahead forecast with themes, key periods, eclipses and retrogrades",
	"keywords": [
		"western astrology",
		"roxyapi",
		"get",
		"yearly"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"sign": {
			"type": "string",
			"default": ""
		},
		"lang": {
			"type": "string",
			"default": ""
		},
		"year": {
			"type": "string",
			"default": ""
		},
		"timezone": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
