		"latitude": {
			"type": "string",
			"default": ""
		},
		"longitude": {
			"type": "string",
			"default": ""
		},
		"timezone": {
			"type": "string",
			"default": ""
		},
		"ayanamsa": {
			"type": "string",
			"default": ""
		},
		"ayanamsaValue": {
			"type": "string",
			"default": ""
		},
		"signDoshaScheme": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
