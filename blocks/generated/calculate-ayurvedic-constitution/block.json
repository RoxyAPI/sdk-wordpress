{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/calculate-ayurvedic-constitution",
	"title": "Ayurvedic Constitution (Ayurveda)",
	"category": "roxyapi",
	"icon": "star-half",
