{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/numerology",
	"title": "Numerology",
	"category": "roxyapi",
	"icon": "calculator",
	"description": "Life path, expression, and soul urge from a name and date.",
	"keywords": [
		"numerology",
		"life path",
		"numbers",
		"roxyapi"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"name": {
			"type": "string",
			"default": ""
		},
		"birth_date": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
