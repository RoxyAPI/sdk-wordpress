{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/list-hexagrams",
	"title": "Hexagrams (I Ching)",
	"category": "roxyapi",
	"icon": "superhero",
	"description": "Browse all 64 I-Ching hexagrams from the Book of Changes with their Chinese names, English translations, and trigram compositions",
	"keywords": [
		"i ching",
		"roxyapi",
		"list",
		"hexagrams"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"inserter": false
	},
	"attributes": {
		"lang": {
			"type": "string",
			"default": ""
		},
		"limit": {
			"type": "string",
			"default": ""
		},
		"offset": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
