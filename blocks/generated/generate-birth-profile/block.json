{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/generate-birth-profile",
	"title": "Birth Profile (Kabbalah)",
	"category": "roxyapi",
	"icon": "format-image",
	"description": "Hebrew birthday and birth angel",
	"keywords": [
		"kabbalah",
		"roxyapi",
		"generate",
		"birth"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"date": {
			"type": "string",
			"default": ""
		},
		"time": {
			"type": "string",
			"default": ""
		},
		"timezone": {
			"type": "string",
			"default": ""
		},
		"angelDating": {
			"type": "string",
			"default": ""
		},
		"yearStart": {
			"type": "string",
			"default": ""
		},
		"leapDayPolicy": {
			"type": "string",
			"default": ""
		},
		"afterSunset": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
