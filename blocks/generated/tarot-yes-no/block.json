{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/tarot-yes-no",
	"title": "Tarot Yes or No",
	"category": "roxyapi",
	"icon": "yes-alt",
	"description": "Single-card Yes / No / Maybe answer with strength rating and interpretation.",
	"keywords": [
		"tarot",
		"yes or no",
		"card",
		"roxyapi"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"question": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
