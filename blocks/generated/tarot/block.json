{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/tarot",
	"title": "Tarot Card",
	"category": "roxyapi",
	"icon": "tag",
	"description": "Single card, three card, or Celtic Cross spreads.",
	"keywords": [
		"tarot",
		"card reading",
		"spread",
		"roxyapi"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"spread": {
			"type": "string",
			"default": ""
		},
		"question": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
