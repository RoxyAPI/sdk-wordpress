{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/get-birthstones",
	"title": "Birthstones by Month (Crystals)",
	"category": "roxyapi",
	"icon": "star-filled",
