{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/list-hebrew-letters",
	"title": "Hebrew Letters (Kabbalah)",
	"category": "roxyapi",
	"icon": "format-image",
	"description": "Hebrew alphabet with the Sefer Yetzirah attributions",
	"keywords": [
		"kabbalah",
		"roxyapi",
		"list",
		"hebrew"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"lang": {
			"type": "string",
			"default": ""
		},
		"letterAttribution": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
