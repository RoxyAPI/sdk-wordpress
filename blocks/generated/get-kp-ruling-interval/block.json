{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/get-kp-ruling-interval",
	"title": "KP Ruling Planets with Significators (Vedic Astrology)",
	"category": "roxyapi",
	"icon": "database",
	"description": "Calculate ruling planets and their KP significators at regular time intervals using Krishnamurti Paddhati prashna (horary) astrology",
	"keywords": [
		"vedic astrology",
		"roxyapi",
		"get",
		"kp"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"inserter": false
	},
	"attributes": {
		"startDatetime": {
			"type": "string",
			"default": ""
		},
		"endDatetime": {
			"type": "string",
			"default": ""
		},
		"intervalMinutes": {
			"type": "string",
			"default": ""
		},
		"latitude": {
			"type": "string",
			"default": ""
		},
		"longitude": {
			"type": "string",
			"default": ""
		},
		"timezone": {
			"type": "string",
			"default": ""
		},
		"ayanamsa": {
			"type": "string",
			"default": ""
		},
		"nodeType": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
