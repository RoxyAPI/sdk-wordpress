{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/natal-chart",
	"title": "Natal Chart",
	"category": "roxyapi",
	"icon": "admin-users",
	"description": "Western birth chart with planets, houses, and aspects.",
	"keywords": [
		"birth chart",
		"astrology",
		"natal chart",
		"roxyapi"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"birth_date": {
			"type": "string",
			"default": ""
		},
		"birth_time": {
			"type": "string",
			"default": ""
		},
		"lat": {
			"type": "string",
			"default": ""
		},
		"lon": {
			"type": "string",
			"default": ""
		},
		"tz": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
