{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/generate-bazi-chart",
	"title": "BaZi Chart (Chinese Astrology)",
	"category": "roxyapi",
	"icon": "lightbulb",
	"description": "Calculate a complete BaZi chart, the Four Pillars of Destiny, from a birth moment",
	"keywords": [
		"chinese astrology",
		"roxyapi",
		"generate",
		"bazi"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"date": {
			"type": "string",
			"default": ""
		},
		"time": {
			"type": "string",
			"default": ""
		},
		"timezone": {
			"type": "string",
			"default": ""
		},
		"latitude": {
			"type": "string",
			"default": ""
		},
		"longitude": {
			"type": "string",
			"default": ""
		},
		"dayBoundary": {
			"type": "string",
			"default": ""
		},
		"yearBoundary": {
			"type": "string",
			"default": ""
		},
		"hourClock": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
