{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/calculate-birth-day",
	"title": "Birth Day Number (Numerology)",
	"category": "roxyapi-catalog",
	"icon": "chart-line",
	"description": "Calculate the Birth Day number from the day of the month a person was born, 1 to 31, with Pythagorean numerology",
	"keywords": [
		"numerology",
		"roxyapi",
		"calculate",
		"birth"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"day": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
