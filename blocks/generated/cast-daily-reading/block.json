{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/cast-daily-reading",
	"title": "Cast Daily I-Ching Reading",
	"category": "roxyapi",
	"icon": "superhero",
	"description": "Cast a complete daily I-Ching reading using the traditional three-coin method with seeded randomness",
	"keywords": [
		"i ching",
		"roxyapi",
		"cast",
		"daily"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"seed": {
			"type": "string",
			"default": ""
		},
		"date": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
