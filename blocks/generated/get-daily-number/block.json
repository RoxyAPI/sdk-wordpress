{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "roxyapi/get-daily-number",
	"title": "Daily Numerology Number",
	"category": "roxyapi-catalog",
	"icon": "chart-line",
	"description": "Get the numerology Number of the Day, one of 1 to 9, 11, 22 or 33, with its full interpretation",
	"keywords": [
		"numerology",
		"roxyapi",
		"get",
		"daily"
	],
	"version": "1.0.0",
	"textdomain": "roxyapi",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"seed": {
			"type": "string",
			"default": ""
		},
		"date": {
			"type": "string",
			"default": ""
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js"
}
